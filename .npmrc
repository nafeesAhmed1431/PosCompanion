# better-sqlite3 (and any other native N-API addon) needs a binary built
# against Electron's Node-API ABI, not the system Node's — this app's main
# process only ever runs inside Electron, never plain `node`. Without this,
# a plain `npm install` fetches/links the Node prebuild and better-sqlite3
# crashes (hard native crash, not a catchable JS error) the moment a
# Database is opened inside Electron's main process.
runtime=electron
target=33.4.11
disturl=https://electronjs.org/headers
